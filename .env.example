# pf-web-frontend-internal — variables de entorno
#
# Copia este archivo a .env.local y rellena los valores. Nada de secretos aqui:
# todo lo que lleve prefijo VITE_ acaba en el bundle y es publico por definicion.

# --- Las dos rutas de datos, y son dos servicios distintos ---
# bff: la unica superficie HTTP de comandos y consultas.
VITE_API_BASE_URL=http://localhost:8080

# realtime: el stream SSE. NO pasa por bff, aunque este detras del mismo borde.
# Si se deja vacio, la app arranca en modo pull-only (ver ADR 10).
VITE_STREAM_BASE_URL=http://localhost:8081

# --- Identidad ---
# El login va contra bff (POST /api/v1/sesion), no contra Cognito directamente.
# Estas variables existen solo para el caso en que se decida el flujo hosted UI.
# TODO(auth): confirmar si hacen falta. Ver "decisiones abiertas" en el README.
VITE_COGNITO_USER_POOL_ID=
VITE_COGNITO_CLIENT_ID=

# --- Mocks ---
# No lo pongas aqui: usa `pnpm dev:mock`, que carga .env.mock. Se documenta solo para
# que se sepa que existe. Con los mocks activos hay un `bff` y un `realtime` simulados
# en src/mocks/, y se entra con operador@demo.ai27 / demo1234.
# VITE_ENABLE_MOCKS=true
