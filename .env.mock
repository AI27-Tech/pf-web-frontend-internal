# Modo mock: `pnpm dev:mock` y `pnpm build:mock`.
#
# Vite da mas prioridad a .env.[mode] que a .env.local, asi que este archivo gana
# cuando se corre con --mode mock, sin tocar tu configuracion local.

VITE_ENABLE_MOCKS=true

# Vacio = mismo origen. MSW intercepta antes de que la peticion salga.
VITE_API_BASE_URL=

# Un origen falso a proposito: deja claro que no hay ningun `realtime` detras, y el
# service worker de MSW lo intercepta igual porque casa por ruta, no por origen.
# Basta con que no este vacio para que STREAM_ENABLED sea true y la ruta push exista.
VITE_STREAM_BASE_URL=http://realtime.mock.ai27
